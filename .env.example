# Copy to .env and fill in. Nothing here is required for --offline runs.

# Gemini (Google AI Studio key). Without it the agents fall back to deterministic heuristics.
GEMINI_API_KEY=
# Tried in order; the first model the key can access wins.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# GitHub (only for remote repos: CI history, issues/PRs, and opening a draft PR with --open-pr)
GITHUB_TOKEN=

# Where investigations, sandbox workspaces and caches live (default: .rd/ inside this repo, gitignored)
# RD_HOME=.rd

# Sandbox: local (default: one virtualenv per dependency set, tests run as subprocesses)
#          docker (optional: network-less, read-only, resource-capped container per probe; pip install docker)
RD_SANDBOX=local
RD_PYTHON=3.12
